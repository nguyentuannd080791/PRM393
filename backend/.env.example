# =============================================================================
# Facebook Clone (fb_clone) - Backend Environment Configuration
# =============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# Option A: Discrete Connection Parameters (Local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fb_clone
DB_SSL=false
DB_POOL_MAX=20

# Option B: Unified Connection String (Cloud PostgreSQL: Supabase / Neon / RDS)
# If DATABASE_URL is provided, it takes precedence over DB_HOST/PORT/USER/PASSWORD/NAME.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fb_clone?sslmode=disable
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-1.aws.neon.tech/fb_clone?sslmode=require

# -----------------------------------------------------------------------------
# JWT Authentication Security (BR-04, BR-06)
# -----------------------------------------------------------------------------
JWT_SECRET=super_secret_fb_clone_course_project_jwt_key_2026_prm393
JWT_EXPIRES_IN=7d
